# Copy to .env (git-ignored) and load it with `set -a; source .env; set +a`, or
# export these in your shell (no script auto-loads .env). Nothing here is

# Gemini 3.1 Pro via OpenRouter (run_*_frontier.py, MODEL=gemini runs)
OPENROUTER_API_KEY=

# Hugging Face: token only needed for uploading (scripts/upload_to_hf.py)
# HF_TOKEN=
# Dataset repo id used by scripts/download_data.py
# SGF_HF_DATASET=rasulkhanbayov/sgf
# Model-weight cache (default: ~/sgf_hf_cache)
# HF_HOME=

# Path overrides (defaults shown; see code/sgf_paths.py)
# SGF_DATA_DIR=<repo>/data
# SGF_RAW_VIDEO_DIR=<repo>/data/raw_videos
# SGF_RESULTS_DIR=<repo>/results

# Slurm jobs: conda install location and repo root (default: submit dir)
# CONDA_DIR=$HOME/miniconda3
# SGF_REPO_ROOT=

# Model checkpoint revisions (defaults = the paper's, Appendix B.4)
# SGF_QWEN25VL_REVISION=cc594898137f460bfe9f0759e9844b3ce807cfb5
# SGF_QWEN3VL_REVISION=9c4b90e1e4ba969fd3b5378b57d966d725f1b86c
